{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-section"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-about-band"
      },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "props": {
            "className": "gallery-kicker"
          },
          "text": "$t:gallery.home.about_kicker"
        },
        {
          "type": "basic",
          "name": "H2",
          "props": {
            "className": "gallery-section-title"
          },
          "text": "$t:gallery.home.about_title"
        },
        {
          "type": "basic",
          "name": "P",
          "props": {
            "className": "gallery-body-lg"
          },
          "text": "$t:gallery.home.about_body"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "gallery-chip-list"
          },
          "children": [
            {
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "gallery-chip"
              },
              "iteration": {
                "source": "gallery_about_paths",
                "item_var": "path"
              },
              "text": "{{$t(path.title_key)}}"
            }
          ]
        },
        {
          "type": "basic",
          "name": "A",
          "props": {
            "href": "/about",
            "className": "gallery-text-link"
          },
          "text": "$t:gallery.home.about_action"
        }
      ]
    }
  ]
}
