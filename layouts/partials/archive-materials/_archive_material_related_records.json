{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-section"
  },
  "children": [
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "gallery-kicker"
      },
      "text": "$t:gallery.archive_materials.related_records"
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-list"
      },
      "children": [
        {
          "type": "basic",
          "name": "A",
          "props": {
            "href": "{{record.href ?? \"/records\"}}",
            "className": "gallery-record gallery-record-link"
          },
          "iteration": {
            "source": "gallery_archive_material_detail.related_records",
            "item_var": "record"
          },
          "children": [
            {
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "gallery-meta"
              },
              "text": "{{record.type}}"
            },
            {
              "type": "basic",
              "name": "H3",
              "props": {
                "className": "gallery-record-title"
              },
              "text": "{{$t(record.title_key)}}"
            },
            {
              "type": "basic",
              "name": "P",
              "props": {
                "className": "gallery-record-body"
              },
              "text": "{{$t(record.summary_key)}}"
            }
          ]
        }
      ]
    }
  ]
}
