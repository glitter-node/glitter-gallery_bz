{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-section gallery-section-tight"
  },
  "children": [
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-feature-details gallery-metadata-grid"
      },
      "children": [
        {
          "type": "basic",
          "name": "P",
          "iteration": {
            "source": "gallery_exhibition_detail.metadata",
            "item_var": "meta"
          },
          "text": "{{$t(meta.label_key)}}: {{$t(meta.value_key)}}"
        }
      ]
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-record-meta-list"
      },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "props": {
            "className": "gallery-chip"
          },
          "iteration": {
            "source": "gallery_exhibition_detail.tags",
            "item_var": "tag"
          },
          "text": "{{$t(\"gallery.tags.\" + tag)}}"
        }
      ]
    }
  ]
}
