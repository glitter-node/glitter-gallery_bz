{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-page-head gallery-exhibition-detail-hero"
  },
  "children": [
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "gallery-kicker"
      },
      "text": "$t:gallery.exhibition_detail.kicker"
    },
    {
      "type": "basic",
      "name": "H1",
      "props": {
        "className": "gallery-page-title"
      },
      "text": "{{$t(gallery_exhibition_detail.title_key)}}"
    },
    {
      "type": "basic",
      "name": "P",
      "props": {
        "className": "gallery-page-lead"
      },
      "text": "{{$t(gallery_exhibition_detail.subtitle_key)}}"
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-media-frame gallery-media-detail gallery-media-detail-panel gallery-exhibition-detail-cover"
      },
      "children": [
        {
          "type": "basic",
          "name": "Img",
          "props": {
            "src": "{{(gallery_exhibition_detail.image_url ?? gallery_exhibition_detail.preview_image ?? gallery_exhibition_detail.cover_image ?? gallery_exhibition_detail.featured_image?.url ?? \"\")}}",
            "alt": "{{gallery_exhibition_detail.title_label ?? $t(gallery_exhibition_detail.title_key ?? 'gallery.media.detail_hero')}}",
            "className": "gallery-media-image"
          },
          "if": "{{gallery_exhibition_detail.image_url ?? gallery_exhibition_detail.preview_image ?? gallery_exhibition_detail.cover_image ?? gallery_exhibition_detail.featured_image?.url ?? false}}"
        },
        {
          "type": "basic",
          "name": "Div",
          "props": {
            "className": "gallery-media-placeholder gallery-media-installation"
          },
          "if": "{{!(gallery_exhibition_detail.image_url ?? gallery_exhibition_detail.preview_image ?? gallery_exhibition_detail.cover_image ?? gallery_exhibition_detail.featured_image?.url ?? false)}}",
          "children": [
            {
              "type": "basic",
              "name": "Span",
              "props": {
                "className": "gallery-media-placeholder-label"
              },
              "text": "$t:gallery.media.detail_hero"
            }
          ]
        },
        {
          "type": "basic",
          "name": "Span",
          "props": {
            "className": "gallery-media-caption"
          },
          "text": "{{gallery_exhibition_detail.media_caption ?? gallery_exhibition_detail.featured_image?.credit ?? $t('gallery.media.preview_caption')}}"
        }
      ]
    }
  ]
}
