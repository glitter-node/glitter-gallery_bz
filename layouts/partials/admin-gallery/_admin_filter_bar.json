{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-section gallery-filter-panel gallery-admin-filter"
  },
  "children": [
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "gallery-kicker"
      },
      "text": "$t:gallery.admin.filters.ready"
    },
    {
      "type": "basic",
      "name": "P",
      "props": {
        "className": "gallery-muted"
      },
      "text": "$t:gallery.admin.filters.body"
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-chip-list"
      },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "props": {
            "className": "gallery-chip"
          },
          "iteration": {
            "source": "admin_gallery.filters",
            "item_var": "filter"
          },
          "text": "{{$t(filter.label_key)}}"
        }
      ]
    }
  ]
}
