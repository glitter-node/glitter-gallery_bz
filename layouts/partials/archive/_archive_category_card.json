{
    "meta": {
        "is_partial": true
    },
    "type": "basic",
    "name": "A",
    "iteration": {
        "source": "gallery_archive_index.categories",
        "item_var": "category"
    },
    "props": {
        "href": "{{category.href ?? \"/archive\"}}",
        "className": "{{category.card_class ?? 'gallery-card'}} gallery-record-link gallery-index-card"
    },
    "children": [
        {
            "type": "basic",
            "name": "Span",
            "props": {
                "className": "gallery-meta"
            },
            "text": "{{$t(category.meta_key)}}"
        },
        {
            "type": "basic",
            "name": "H2",
            "props": {
                "className": "gallery-card-title"
            },
            "text": "{{$t(category.title_key)}}"
        },
        {
            "type": "basic",
            "name": "P",
            "props": {
                "className": "gallery-card-body"
            },
            "text": "{{$t(category.body_key)}}"
        },
        {
            "type": "basic",
            "name": "Div",
            "if": "{{(category.relationship_meta ?? []).length > 0}}",
            "props": {
                "className": "gallery-relationship-row"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "iteration": {
                        "source": "category.relationship_meta",
                        "item_var": "meta"
                    },
                    "text": "{{meta.value !== undefined ? $t(meta.label_key) + ' ' + meta.value : $t(meta.label_key)}}"
                }
            ]
        },
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "gallery-record-meta-list"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "Span",
                    "props": {
                        "className": "gallery-chip"
                    },
                    "text": "{{$t(\"gallery.archive.index.material_count\")}} {{category.material_count ?? 0}}"
                },
                {
                    "type": "basic",
                    "name": "Span",
                    "iteration": {
                        "source": "category.type_summary",
                        "item_var": "type"
                    },
                    "props": {
                        "className": "gallery-chip"
                    },
                    "text": "{{$t(\"gallery.archive_materials.types.\" + type)}}"
                }
            ]
        }
    ]
}
