{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-section gallery-filter-panel"
  },
  "children": [
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "gallery-kicker"
      },
      "text": "$t:gallery.filters.ready_kicker"
    },
    {
      "type": "basic",
      "name": "P",
      "props": {
        "className": "gallery-muted"
      },
      "text": "$t:gallery.records.index.filter_ready_body"
    },
    {
      "type": "basic",
      "name": "Div",
      "props": {
        "className": "gallery-chip-list"
      },
      "children": [
        {
          "type": "basic",
          "name": "Span",
          "props": {
            "className": "gallery-chip"
          },
          "iteration": {
            "source": "gallery_records_index.filters.record_type_filters",
            "item_var": "filter"
          },
          "text": "{{$t(filter.label_key)}}"
        },
        {
          "type": "basic",
          "name": "Span",
          "props": {
            "className": "gallery-chip"
          },
          "iteration": {
            "source": "gallery_records_index.filters.sort_options",
            "item_var": "sort"
          },
          "text": "{{$t(sort.label_key)}}"
        }
      ]
    }
  ]
}
