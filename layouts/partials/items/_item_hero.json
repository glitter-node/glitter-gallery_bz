{
  "meta": {
    "is_partial": true
  },
  "type": "basic",
  "name": "Section",
  "props": {
    "className": "gallery-page-head gallery-item-detail-hero"
  },
  "children": [
    {
      "type": "basic",
      "name": "Span",
      "props": {
        "className": "gallery-kicker"
      },
      "text": "{{gallery_item_detail.type}}"
    },
    {
      "type": "basic",
      "name": "H1",
      "props": {
        "className": "gallery-page-title"
      },
      "text": "{{$t(gallery_item_detail.title_key)}}"
    },
    {
      "type": "basic",
      "name": "P",
      "props": {
        "className": "gallery-page-lead"
      },
      "text": "{{$t(gallery_item_detail.subtitle_key)}}"
    },
    {
      "type": "basic",
      "name": "A",
      "props": {
        "href": "{{gallery_item_detail.exhibition_href ?? \"/exhibitions\"}}",
        "className": "gallery-text-link"
      },
      "text": "$t:gallery.items.back_to_exhibition"
    }
  ]
}
